---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hexagon from '../components/Hexagon.astro';
import HexRow from '../components/HexRow.astro';
import { homeSchema, parsePage } from '../schemas/pages';
import { withBase } from '../lib/paths';
import raw from '../data/home.json';

const data = parsePage(homeSchema, raw, 'home');
---

<BaseLayout title={data.title} showChrome={false}>
  <div class="mx-auto grid min-h-screen max-w-6xl place-items-center px-6 py-16">
    <div class="w-full">
      <h1 class="sr-only">{data.title}</h1>
      <!--
        Pastel fills matching the Local Food Space honeycomb, with the charcoal
        border keeping neighbours distinct. The centre hexagon sits on top and
        is split: photo above, text below.
      -->
      <HexRow size="lg">
        <Hexagon fill="orange-soft" size="lg" href={withBase('/campaigns-history')}>
          {data.campaignsHexLabel}
        </Hexagon>
        <Hexagon
          fill="green-soft"
          size="lg"
          photo={data.portrait}
          photoAlt="Katie Jarman"
          photoLabel="Your photo"
        >
          {data.title}
        </Hexagon>
        <Hexagon fill="yellow-soft" size="lg" href={withBase('/concepts')}>
          {data.conceptsHexLabel}
        </Hexagon>
      </HexRow>
    </div>
  </div>
</BaseLayout>
