---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Scaffold check" showChrome={false}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-4xl font-extrabold text-charcoal">Scaffold check</h1>
    <p class="mt-4 text-charcoal">
      Manrope, cream background, charcoal text.
    </p>
    <div class="mt-8 flex gap-3">
      <span class="h-12 w-12 rounded bg-green"></span>
      <span class="h-12 w-12 rounded bg-charcoal"></span>
      <span class="h-12 w-12 rounded bg-orange"></span>
      <span class="h-12 w-12 rounded bg-yellow"></span>
      <span class="h-12 w-12 rounded border-2 border-charcoal bg-cream"></span>
    </div>
  </div>
</BaseLayout>
