---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ImageOrPlaceholder from '../components/ImageOrPlaceholder.astro';
import { conceptsSchema, parsePage } from '../schemas/pages';
import { withBase } from '../lib/paths';
import raw from '../data/concepts.json';

const data = parsePage(conceptsSchema, raw, 'concepts');
---

<BaseLayout title={data.title} description={data.subtitle}>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">
      {data.title}
    </h1>
    <p class="mt-3 text-lg text-charcoal sm:text-xl">{data.subtitle}</p>

    <div class="mt-8 divide-y-2 divide-charcoal/10">
      <Section heading={data.sectionOne.heading} body={data.sectionOne.body}>
        <ImageOrPlaceholder
          slot="media"
          src={data.sectionOne.image}
          alt={data.sectionOne.heading}
          label="Community storytelling image"
        />
      </Section>

      <Section
        heading={data.sectionTwo.heading}
        body={data.sectionTwo.body}
        reverse
      >
        <div slot="media" class="grid gap-4">
          <ImageOrPlaceholder
            src={data.sectionTwo.image}
            alt={`${data.sectionTwo.heading}, first image`}
            label="Food rights image one"
            width={800}
            height={500}
          />
          <ImageOrPlaceholder
            src={data.sectionTwo.imageTwo}
            alt={`${data.sectionTwo.heading}, second image`}
            label="Food rights image two"
            width={800}
            height={500}
          />
        </div>
      </Section>

      <Section heading={data.sectionThree.heading} body={data.sectionThree.body}>
        <Fragment slot="media">
          <ImageOrPlaceholder
            src={data.sectionThree.mapScreenshot}
            alt="Community food spaces map. Select to view impact detail."
            label="Community food spaces map screenshot"
            href={withBase('/impact')}
          />
          <p class="mt-3 text-sm text-charcoal">
            <a href={withBase('/impact')} class="font-semibold text-green underline">
              View Community Food Spaces Impact
            </a>
          </p>
        </Fragment>
      </Section>
    </div>
  </div>
</BaseLayout>
