---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageOrPlaceholder from '../components/ImageOrPlaceholder.astro';
import Hexagon from '../components/Hexagon.astro';
import HexGrid from '../components/HexGrid.astro';
import { impactSchema, parsePage } from '../schemas/pages';
import raw from '../data/impact.json';

const data = parsePage(impactSchema, raw, 'impact');

/**
 * Per Katie's notes: the three central hexagons are 20%-saturated green, and
 * the four outer ones alternate 20%-saturated orange and yellow. All three
 * fills are light, so Hexagon gives them charcoal text.
 */
const outerFills = ['orange-soft', 'yellow-soft'] as const;
const outerFillAt = (index: number) => outerFills[index % outerFills.length]!;
---

<BaseLayout title={data.title}>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">
      {data.title}
    </h1>

    <section class="mt-8">
      <h2 class="sr-only">Community food space detail</h2>
      <ImageOrPlaceholder
        src={data.pantryScreenshot}
        alt="Christ Church Toxteth Park Pantry listing"
        label="Christ Church Toxteth Park Pantry page screenshot"
        width={1200}
        height={900}
      />
    </section>

    <section class="mt-16 border-t-2 border-charcoal/10 pt-12">
      <h2 class="text-2xl font-extrabold text-charcoal sm:text-3xl">
        Collective impact
      </h2>

      <div class="mt-10">
        <HexGrid>
          <Fragment slot="rowOne">
            {
              data.rowOne.map((hex, index) => (
                <Hexagon fill={outerFillAt(index)}>
                  <span class="block text-xl font-extrabold sm:text-2xl">
                    {hex.value}
                  </span>
                  <span class="mt-1 block text-[0.65rem] font-semibold leading-snug sm:text-xs">
                    {hex.label}
                  </span>
                </Hexagon>
              ))
            }
          </Fragment>

          <Fragment slot="rowTwo">
            {
              data.rowTwo.map((hex) => (
                <Hexagon
                  fill="green-soft"
                  photo={hex.photo}
                  photoAlt={`${hex.name}, ${hex.role}`}
                  photoLabel="Photo"
                >
                  <span class="block text-[0.6rem] font-semibold uppercase tracking-wide">
                    {hex.role}
                  </span>
                  <span class="mt-0.5 block text-xs font-extrabold sm:text-sm">
                    {hex.name}
                  </span>
                </Hexagon>
              ))
            }
          </Fragment>

          <Fragment slot="rowThree">
            {
              data.rowThree.map((hex, index) => (
                <Hexagon fill={outerFillAt(index + 1)}>
                  <span class="block text-xl font-extrabold sm:text-2xl">
                    {hex.value}
                  </span>
                  <span class="mt-1 block text-[0.65rem] font-semibold leading-snug sm:text-xs">
                    {hex.label}
                  </span>
                </Hexagon>
              ))
            }
          </Fragment>
        </HexGrid>
      </div>
    </section>
  </div>
</BaseLayout>
