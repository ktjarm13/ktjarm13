---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignCard from '../components/CampaignCard.astro';
import { campaignsHistorySchema, parsePage } from '../schemas/pages';
import raw from '../data/campaigns-history.json';

const data = parsePage(campaignsHistorySchema, raw, 'campaigns-history');
---

<BaseLayout title={data.title}>
  <div class="mx-auto max-w-6xl px-6 py-12">
    <h1 class="font-display text-4xl text-charcoal sm:text-5xl">
      {data.title}
    </h1>

    <!--
      Katie asked for the three campaigns "presented vertically rather than
      horizontally": three columns, each stacking its own content top to bottom,
      as in her reference image. Below lg they fall into a single column.
    -->
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        data.sections.map((section) => (
          <CampaignCard
            heading={section.heading}
            body={section.body}
            image={section.image}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
