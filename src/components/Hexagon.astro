---
interface Props {
  fill?: 'green' | 'charcoal' | 'orange' | 'yellow';
  href?: string;
  label?: string;
  size?: 'md' | 'lg';
}

const { fill = 'green', href, label, size = 'md' } = Astro.props;

const fillClass = {
  green: 'bg-green text-white',
  charcoal: 'bg-charcoal text-white',
  orange: 'bg-orange text-white',
  // Yellow is light; white text on it fails contrast, so use charcoal.
  yellow: 'bg-yellow text-charcoal',
}[fill];

const sizeClass = size === 'lg' ? 'w-72 sm:w-80' : 'w-56 sm:w-64';
const Tag = href ? 'a' : 'div';
/** Slot content wins when present; `label` is the simple single-string case. */
const hasSlot = Astro.slots.has('default');
---

<Tag
  class:list={[
    'hexagon group relative grid place-items-center text-center no-underline',
    'transition-transform duration-200',
    sizeClass,
    fillClass,
    href && 'hover:scale-[1.03] focus-visible:scale-[1.03]',
    href &&
      'focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-charcoal',
  ]}
  {...href ? { href } : {}}
>
  <span class="hexagon-body text-sm font-extrabold leading-tight sm:text-base">
    {hasSlot ? <slot /> : label}
  </span>
</Tag>

<style>
  .hexagon {
    /* Flat-top hexagon, matching Katie's wireframes: points left and right,
       flat edges top and bottom. Height = width * cos(30deg). */
    aspect-ratio: 1 / 0.866;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
  }

  /* A flat-top hexagon narrows toward its left and right points, so the safe
     text width depends on vertical position. Capping the column at 70% of
     width keeps text clear of the diagonals at the heights text occupies.
     Set on the element itself rather than via a Tailwind utility so it is not
     overridden by the display utility. */
  .hexagon-body {
    display: block;
    max-width: 66%;
    overflow-wrap: break-word;
    hyphens: auto;
  }
</style>
