---
// Home page cluster: three flat-top hexagons that fit together.
//
// Flat-top geometry, width W, height H = W * 0.866: a neighbour nests into the
// notch when it sits 0.75W across and H/2 up or down. So the row overlaps
// horizontally by a quarter width and the middle hexagon is raised by half a
// height — the same relationship HexGrid uses between rows.
//
// Children arrive through a slot, so they carry no scoped-style attribute. The
// child selectors are :global() to reach them; the .hex-cluster prefix keeps
// them from leaking to the rest of the page.
//
// Offsets are margins, not transforms, because Hexagon applies its own
// transform on hover and focus.

interface Props {
  /** Must match the Hexagon `size` used inside, so offsets line up. */
  size?: 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
---

<div class="hex-cluster" data-size={size}>
  <slot />
</div>

<style>
  .hex-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .hex-cluster {
      /* Hexagon width at each size above sm, and its flat-top height. */
      --hex-w: 16rem; /* w-64 */
      --hex-h: calc(var(--hex-w) * 0.866);

      flex-direction: row;
      justify-content: center;
      align-items: flex-start;
      gap: 0;
    }

    .hex-cluster[data-size='lg'] {
      --hex-w: 20rem; /* w-80 */
    }

    /* Neighbours sit 0.75W apart, so pull in by a quarter width. */
    :global(.hex-cluster > * + *) {
      margin-left: calc(var(--hex-w) / -4);
    }

    /* The middle hexagon drops into the notch: half a height down. */
    :global(.hex-cluster > *:nth-child(even)) {
      margin-top: calc(var(--hex-h) / 2);
    }
  }
</style>
