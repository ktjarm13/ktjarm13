---
// Home page cluster: three hexagons in a staggered row.
//
// Per Katie's wireframe the hexagons TOUCH but never overlap: neighbours sit
// edge to edge with a small gap, and the middle one is raised so the cluster
// reads as a honeycomb fragment rather than a straight line.
//
// Children arrive through a slot, so they carry no scoped-style attribute.
// The child selector is :global() to reach them; the .hex-cluster prefix keeps
// it from leaking to the rest of the page.
//
// The offset is computed from --hex-h rather than hard-coded so it holds at
// both Hexagon sizes. It uses margin, not transform, because Hexagon applies
// its own transform on hover and focus.

interface Props {
  /** Must match the Hexagon `size` used inside, so the offset lines up. */
  size?: 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
---

<div class="hex-cluster" data-size={size}>
  <slot />
</div>

<style>
  .hex-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .hex-cluster {
      /* Hexagon width at each size above sm, and its flat-top height. */
      --hex-w: 16rem; /* w-64 */
      --hex-h: calc(var(--hex-w) * 0.866);

      flex-direction: row;
      justify-content: center;
      align-items: flex-start;
      gap: 0;
    }

    .hex-cluster[data-size='lg'] {
      --hex-w: 20rem; /* w-80 */
    }

    /* Flat-top hexagons tessellate at 3/4 width horizontally. Pulling
       neighbours in by a quarter-width, less a hairline, puts the diagonal
       edges against each other without the fills ever overlapping.
       (gap cannot be negative, so this is a margin.) */
    :global(.hex-cluster > * + *) {
      margin-left: calc(var(--hex-w) / -4 + 0.25rem);
    }

    /* Raise the middle hexagon so its lower diagonals sit against the
       neighbours' upper diagonals, as in the wireframe. Half of height is
       where those edges meet when spacing is 3/4 width. */
    :global(.hex-cluster > *:nth-child(even)) {
      margin-top: calc(var(--hex-h) / -2);
    }
  }
</style>
