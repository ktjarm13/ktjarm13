---
// Impact page honeycomb: rows of 2, 3, 2.
//
// Row children arrive through slots, so they carry no scoped-style attribute:
// the child selectors are :global() to reach them, prefixed with .hex-row so
// they do not leak to the rest of the page.
//
// Offsets are computed from --hex-w, matching HexRow's approach. A percentage
// margin would resolve against the container rather than the hexagon and
// collapse the rows.
---

<div class="hex-honeycomb">
  <div class="hex-row">
    <slot name="rowOne" />
  </div>
  <div class="hex-row hex-row-nested">
    <slot name="rowTwo" />
  </div>
  <div class="hex-row hex-row-nested">
    <slot name="rowThree" />
  </div>
</div>

<style>
  .hex-honeycomb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hex-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .hex-honeycomb {
      /* Hexagon width above sm (w-64), and its pointy-top height. */
      --hex-w: 16rem;
      --hex-h: calc(var(--hex-w) / 0.866);

      gap: 0;
    }

    .hex-row {
      flex-direction: row;
      justify-content: center;
      gap: 0;
    }

    :global(.hex-row > * + *) {
      margin-left: calc(var(--hex-w) / -4);
    }

    /* Pull each row up by a quarter of hexagon height so rows interlock. */
    .hex-row-nested {
      margin-top: calc(var(--hex-h) / -4);
    }
  }
</style>
