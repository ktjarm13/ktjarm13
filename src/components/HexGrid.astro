---
// Local Food Space honeycomb: 7 hexagons as columns of 2, 3, 2.
//
// Flat-top hexagons (points left and right) tessellate in COLUMNS, not rows.
// With width W and height H = W * cos(30deg) = W * 0.866:
//
//   - Columns sit 0.75W apart, so they overlap horizontally by a quarter width
//     and each hexagon's left point tucks into its neighbour's notch.
//   - Within a column, hexagons stack edge to edge: spacing exactly H, no gap.
//   - Adjacent columns are offset vertically by H/2, so a 2-hex column sits
//     exactly in the gaps of a 3-hex column.
//
// A row-based 2/3/2 cannot tessellate flat-top hexagons: centring a 3-wide row
// against a 2-wide row offsets it by W/2, but nesting needs 0.75W. Columns are
// the arrangement that actually fits, and it matches Katie's wireframes.
//
// Slot children carry no scoped-style attribute, so child selectors are
// :global(), prefixed with .hex-col so they do not leak.
---

<div class="hex-honeycomb">
  <div class="hex-col hex-col-outer">
    <slot name="rowOne" />
  </div>
  <div class="hex-col hex-col-centre">
    <slot name="rowTwo" />
  </div>
  <div class="hex-col hex-col-outer">
    <slot name="rowThree" />
  </div>
</div>

<style>
  /* Below sm the honeycomb collapses to one plain vertical column. */
  .hex-honeycomb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hex-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .hex-honeycomb {
      /* Hexagon width above sm (w-64) and its flat-top height. */
      --hex-w: 16rem;
      --hex-h: calc(var(--hex-w) * 0.866);

      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 0;
    }

    .hex-col {
      /* Edge to edge within a column: no gap, no overlap. */
      gap: 0;
    }

    /* Columns overlap horizontally by a quarter width. */
    :global(.hex-honeycomb > * + *) {
      margin-left: calc(var(--hex-w) / -4);
    }
  }
</style>
