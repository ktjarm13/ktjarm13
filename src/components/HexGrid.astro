---
// Impact page honeycomb: rows of 2, 3, 2.
//
// Row children arrive through slots, so they carry no scoped-style attribute:
// the child selectors are :global() to reach them, prefixed with .hex-row so
// they do not leak to the rest of the page.
//
// Offsets are in rem, not percentages: a percentage margin resolves against
// the container's width, not the hexagon's, which collapses the row. Hexagons
// are w-64 (16rem) above sm, so height is 16 / 0.866 = 18.48rem. Quarter-width
// is 4rem; rows overlap by a quarter of height, 4.62rem.
---

<div class="hex-honeycomb">
  <div class="hex-row">
    <slot name="rowOne" />
  </div>
  <div class="hex-row hex-row-nested">
    <slot name="rowTwo" />
  </div>
  <div class="hex-row hex-row-nested">
    <slot name="rowThree" />
  </div>
</div>

<style>
  .hex-honeycomb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hex-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .hex-honeycomb {
      gap: 0;
    }

    .hex-row {
      flex-direction: row;
      justify-content: center;
      gap: 0;
    }

    :global(.hex-row > * + *) {
      margin-left: -4rem;
    }

    /* Pull each row up by a quarter of hexagon height so rows interlock. */
    .hex-row-nested {
      margin-top: -4.62rem;
    }
  }
</style>
