---
import { withBaseLinks } from '../lib/richtext';

interface Props {
  heading: string;
  body: string;
  /** Put the media on the left instead of the right. */
  reverse?: boolean;
}

const { heading, body, reverse = false } = Astro.props;

/** Katie writes `/recipes`; this makes it resolve under the deployed base. */
const html = withBaseLinks(body, import.meta.env.BASE_URL);
---

<section class="py-10">
  <div
    class:list={[
      'grid items-start gap-8 lg:grid-cols-2 lg:gap-12',
      reverse && 'lg:[&>*:first-child]:order-2',
    ]}
  >
    <div>
      <h2 class="text-2xl font-extrabold text-charcoal sm:text-3xl">
        {heading}
      </h2>
      <div class="prose prose-lg mt-4 max-w-none" set:html={html} />
    </div>
    <div>
      <slot name="media" />
    </div>
  </div>
</section>
